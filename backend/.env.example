PORT=3001
DB_SSL=true

# Backend API settings
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-jwt-secret

# Supabase project keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# To fully move backend Postgres from local to Supabase, fill this with the
# database connection string from Supabase -> Connect -> Transaction pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Local Postgres fallback. These are ignored when DATABASE_URL is filled.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=apms
DB_PASSWORD=your-local-db-password
DB_PORT=5432
